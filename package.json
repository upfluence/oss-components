{
  "name": "@upfluence/oss-components",
  "version": "3.99.14",
  "description": "The default blueprint for ember-cli addons.",
  "keywords": [
    "ember-addon"
  ],
  "repository": "https://github.com/upfluence/oss-components",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "npm-run-all lint:* test:*",
    "test:ember": "ember test --silent -r dot",
    "test:ember-compatibility": "ember try:each",
    "test:coverage": "COVERAGE=true pnpm test:ember",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "bash scripts/prepare-git-dependency",
    "prepack": "ember ts:precompile",
    "install-pre-push-hook": "cp ./scripts/pre-push ./.git/hooks/pre-push",
    "remove-pre-push-hook": "rm -rf ./.git/hooks/pre-push",
    "postpack": "ember ts:clean"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@ember/render-modifiers": "^2.1.0",
    "@embroider/macros": "^1.13.4",
    "@embroider/util": "^1.9.0",
    "@floating-ui/dom": "^1.6.3",
    "@fortawesome/fontawesome-pro": "upfluence/fontawesome-pro#pn/vel-6389-upgrade-to-7",
    "babel-plugin-debug-macros": "^0.3.1",
    "bootstrap": "^3.3.7",
    "broccoli-funnel": "^3.0.8",
    "broccoli-merge-trees": "^4.2.0",
    "calculate-cache-key-for-tree": "^2.0.0",
    "dompurify": "^3.3.0",
    "ember-auto-import": "^2.8.1",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cli-ifa": "^0.10.0",
    "ember-cli-less": "^2.0.6",
    "ember-cli-typescript": "^5.3.0",
    "ember-intl": "^6.4.0",
    "ember-modifier": "^3.2.7",
    "ember-truth-helpers": "^3.1.1",
    "resolve": "^1.22.8"
  },
  "peerDependencies": {
    "qunit": "^2.x || ^3.x"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.9",
    "@babel/plugin-transform-class-properties": "^7.23.3",
    "@babel/preset-typescript": "^7.29.7",
    "@ember/jquery": "^2.0.0",
    "@ember/optional-features": "^2.1.0",
    "@ember/test-helpers": "^3.3.1",
    "@embroider/test-setup": "^4.0.0",
    "@glimmer/component": "^1.0.4",
    "@glimmer/tracking": "^1.0.4",
    "@glint/environment-ember-loose": "^1.5.2",
    "@glint/template": "^1.2.1",
    "@storybook/addon-designs": "^10.0.2",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/addon-links": "9.1.21",
    "@storybook/ember": "9.1.21",
    "@storybook/ember-cli-storybook": "^0.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/ember": "^3.0.3",
    "@types/jquery": "^3.5.29",
    "@types/qunit": "^2.19.9",
    "@types/rsvp": "^4.0.8",
    "@types/sinon": "^10.0.2",
    "@upfluence/w-conf": "^0.4.0",
    "babel-loader": "^8.1.0",
    "css-loader": "^5.2.7",
    "ember-cli": "~5.12.0",
    "ember-cli-code-coverage": "^3.0.0",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-typescript-blueprints": "upfluence/ember-cli-typescript-blueprints#ember-4-update",
    "ember-disable-prototype-extensions": "^1.1.3",
    "ember-qunit": "8.1.0",
    "ember-resolver": "12.0.1",
    "ember-sinon-qunit": "^5.0.0",
    "ember-source": "~5.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^3.15.0",
    "ember-try": "^4.0.0",
    "eslint": "^10.5.0",
    "less-loader": "^7.1.0",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "qunit": "^2.22.0",
    "qunit-dom": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "9.1.21",
    "style-loader": "^2.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.95.0"
  },
  "engines": {
    "node": "12.* || 14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  }
}
