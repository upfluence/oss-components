{
  "private": true,
  "repository": "https://github.com/upfluence/oss-components",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @upfluence/oss-components build",
    "build:test-app": "pnpm build && pnpm --filter test-app build",
    "lint": "pnpm exec prettier . --check && pnpm --filter @upfluence/oss-components --filter test-app lint:js && pnpm --filter @upfluence/oss-components --filter test-app lint:hbs",
    "lint:fix": "pnpm exec prettier . --write && pnpm --filter @upfluence/oss-components --filter test-app lint:fix",
    "typecheck": "pnpm --filter @upfluence/oss-components --filter test-app typecheck",
    "start": "pnpm --workspace-root run --color --parallel --stream \"/^start:.*/\"",
    "start:addon": "pnpm --filter @upfluence/oss-components start",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm build && pnpm test:asset-map-build && pnpm --filter test-app test:ember",
    "test:asset-map-build": "pnpm --filter @upfluence/oss-components test:asset-map-build",
    "test:coverage": "COVERAGE=true pnpm test && node scripts/normalize-coverage.cjs",
    "test:ember-compatibility": "pnpm --filter test-app test:ember-compatibility",
    "storybook": "pnpm build && pnpm --filter test-app storybook",
    "build-storybook": "pnpm build && pnpm --filter test-app build-storybook",
    "install-pre-push-hook": "cp scripts/pre-push \"$(git rev-parse --git-path hooks/pre-push)\"",
    "remove-pre-push-hook": "rm -f \"$(git rev-parse --git-path hooks/pre-push)\""
  },
  "devDependencies": {
    "@upfluence/w-conf": "^0.4.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "release-it": "^15.9.3",
    "@release-it-plugins/workspaces": "^3.2.0"
  },
  "engines": {
    "node": "20.* || 22.* || 24.*",
    "pnpm": ">=10"
  },
  "release-it": {
    "plugins": {
      "@release-it-plugins/workspaces": {
        "skipChecks": true,
        "publish": false,
        "workspaces": [
          "oss-components"
        ],
        "additionalManifests": {
          "versionUpdates": [
            "packages/oss-components/package.json"
          ]
        }
      }
    },
    "npm": false
  }
}
