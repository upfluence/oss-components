<div
  class="upf-toggle {{if @value 'upf-toggle--toggled'}} {{if @disabled 'upf-toggle--disabled'}}"
  role="checkbox"
  aria-checked={{if @value "true" "false"}}
  tabindex="0"
  {{on "click" this.switchState}}
  ...attributes
>
  <div class="upf-toggle__switch">
    {{#if @value}}
      <OSS::Icon @icon="fa-check" />
    {{/if}}
  </div>
</div>