{
  "name": "test-app",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "lint": "npm-run-all --aggregate-output --continue-on-error lint:format lint:js lint:hbs",
    "lint:format": "prettier . --check",
    "lint:js": "eslint .",
    "lint:hbs": "ember-template-lint .",
    "lint:fix": "prettier . --write && eslint . --fix && ember-template-lint . --fix",
    "build": "vite build",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "test:ember": "vite build --mode development && ember test --path dist",
    "test:ember-compatibility": "ember try:each",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@ember/optional-features": "^2.1.0",
    "@ember/render-modifiers": "^2.1.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.1.17",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.6",
    "@embroider/test-setup": "^4.0.0",
    "@embroider/util": "^1.9.0",
    "@embroider/vite": "^1.7.2",
    "@glimmer/component": "^1.0.4",
    "@glimmer/tracking": "^1.0.4",
    "@glint/template": "^1.2.1",
    "@rollup/plugin-babel": "^7.0.0",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/ember": "^3.0.3",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.8",
    "@types/sinon": "^22.0.2",
    "@upfluence/oss-components": "workspace:*",
    "@upfluence/w-conf": "^0.4.0",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "broccoli": "^3.5.2",
    "decorator-transforms": "^2.3.1",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~6.12.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-code-coverage": "^3.1.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-typescript": "^5.3.0",
    "ember-disable-prototype-extensions": "^1.1.3",
    "ember-intl": "^6.4.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^3.2.7",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.1",
    "ember-source-channel-url": "^3.0.0",
    "ember-storybook": "^0.5.1",
    "ember-template-lint": "^3.15.0",
    "ember-truth-helpers": "^3.1.1",
    "ember-try": "^4.0.0",
    "eslint": "^10.5.0",
    "less": "4.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "qunit": "^2.22.0",
    "qunit-dom": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "sinon": "^22.1.0",
    "storybook": "^10.6.7",
